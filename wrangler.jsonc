{
  // Cloudflare Workers configuration for dnslocator.online
  "name": "dns-locator",
  "main": "worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  // Explicitly set preview_urls to silence the Wrangler workers.dev warning
  // and prevent duplicate unindexed preview URLs in search engines.
  // Change to true if you want per-version preview URLs enabled.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  }
}
